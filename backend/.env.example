PORT=5000
MONGO_URI=mongodb+srv://your_user:your_password@cluster.mongodb.net/learn-portal
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRE=7d

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id

# Cloudinary (for file uploads)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Frontend URL
CLIENT_URL=http://localhost:5173

# Razorpay (online payments). Leave blank to keep manual UPI only.
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=any_long_random_string_you_also_enter_in_razorpay

# Google Calendar (a fresh Google Meet link for every class, made in the host's
# calendar). Get these with: node scripts/google-calendar-token.js
GOOGLE_CAL_CLIENT_ID=
GOOGLE_CAL_CLIENT_SECRET=
GOOGLE_CAL_REFRESH_TOKEN=
# GOOGLE_CAL_ID=primary

# Email from the portal (welcome mail with login details, password reset codes).
# Gmail / Google Workspace: turn on 2-step verification, create an App password,
# then put the address and that 16-letter password here. Leave blank = no emails.
MAIL_USER=rajeev@rajeevshivah.me
MAIL_PASS=
# MAIL_FROM=codeWithShivah <rajeev@rajeevshivah.me>
# MAIL_HOST=smtp.gmail.com  MAIL_PORT=465

# Tech feed: "why it matters / try this" tips on each news item (Claude API).
# Without it the feed still works, matched to goals by keywords.
ANTHROPIC_API_KEY=
# TECH_AI_MODEL=claude-haiku-5-5
# TECH_AI_DAILY_ARTICLES=80
